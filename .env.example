# Copy to .env and adjust. Every variable the app reads is listed here and in the README.

# --- App ---
PORT=8080
# Public URL as users see it (https://... behind a reverse proxy)
BASE_URL=http://localhost:8080
LOG_LEVEL=info
# Password for the web UI. Empty = no login (set it when the app is reachable by others)
LOGIN_PASS=
# Settings storage: json (default, /data/config.json) or postgres
STORAGE=json

# --- PostgreSQL: only for docker-compose.db.yml (docker compose -f docker-compose.db.yml up -d) ---
# That file sets STORAGE=postgres and builds DATABASE_URL from these three, so leave STORAGE=json above.
# POSTGRES_USER=app
# POSTGRES_PASSWORD=<password>
# POSTGRES_DB=app

# --- Compose ---
# IMAGE=eacer/jira-workloginator:v1.0
# APP_BIND=127.0.0.1   # publish on loopback only when a proxy fronts the app
# APP_PORT=8080
